{
  "name": "timelapse-cli",
  "version": "1.0.0",
  "description": "Automate timelapse video processing workflow",
  "type": "module",
  "bin": {
    "tl": "./dist/index.js"
  },
  "scripts": {
    "build": "tsgo",
    "dev": "tsx src/index.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "check": "tsgo --noEmit && oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript/native-preview": "^7.0.0-dev.20260218.1",
    "@vitest/coverage-v8": "^4.0.18",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
